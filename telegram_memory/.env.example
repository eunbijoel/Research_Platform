# Research Memory Bot 전용. Coding Agent 봇 토큰을 넣지 마세요.
# BotFather에서 새 봇을 만든 뒤 값을 채우고 이 파일을 .env 로 복사합니다.
# python app.py 는 토큰이 있을 때만 Telegram에 연결합니다.
# python app.py check 는 토큰 없이 뼈대만 확인합니다.

TELEGRAM_BOT_TOKEN=

# Comma-separated allowlists (preferred). Singular forms still work for one id.
# User must be in USER_IDS and chat must be in CHAT_IDS (AND).
# Private DM: chat id is usually the same as user id.
# Group/supergroup: chat id looks like -100xxxxxxxxxx
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
# Legacy single-id aliases (optional if *_IDS is set):
# TELEGRAM_ALLOWED_USER_ID=
# TELEGRAM_ALLOWED_CHAT_ID=

# Optional. Default: telegram_memory/data/chat.sqlite3 (not Memory KB)
# TELEGRAM_CHAT_DB=

# Shown first on /start and /help (team web UI)
# PLATFORM_URL=http://bigsoft.iptime.org:51100/

# --- Telethon user-account MVP (optional, separate process) ---
# Does not replace Bot API. Run: python app.py user  /  ./run_telegram.sh user
# Get api_id / api_hash at https://my.telegram.org/apps
# TELETHON_API_ID=
# TELETHON_API_HASH=
# TELETHON_CHAT_IDS=-100xxxxxxxxxx
# Optional trigger prefix (recommended in groups). Empty = all new texts in allowlisted chats.
# TELETHON_TRIGGER=/rm
# Session file (gitignored under data/). First run asks phone + login code in the terminal.
# TELETHON_SESSION=data/telethon.session
