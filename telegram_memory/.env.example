# Research Memory Bot 전용. Coding Agent 봇 토큰을 넣지 마세요.
# BotFather에서 새 봇을 만든 뒤 값을 채우고 이 파일을 .env 로 복사합니다.
# python app.py 는 토큰이 있을 때만 Telegram에 연결합니다.
# python app.py check 는 토큰 없이 뼈대만 확인합니다.

TELEGRAM_BOT_TOKEN=

# Team roster group(s). Members may use the bot via private DM only.
# Bot must be added to each group. Chat id looks like -100xxxxxxxxxx
# Multiple ids: user is allowed if they are a member of ANY listed group.
TELEGRAM_ALLOWED_MEMBER_CHAT_IDS=

# Optional. Default: telegram_memory/data/chat.sqlite3 (not Memory KB)
# TELEGRAM_CHAT_DB=

# Shown first on /start and /help (team web UI)
# PLATFORM_URL=http://bigsoft.iptime.org:51100/

# --- Telethon/MTProto MVP (optional, separate from Bot API) ---
# Personal or Assistant Telegram account. Run: ./run_telegram.sh user
# Get api_id / api_hash at https://my.telegram.org/apps
# TELETHON_API_ID=
# TELETHON_API_HASH=
# Only these chats are handled (comma-separated). DM: usually your user id. Group: -100…
# TELETHON_CHAT_IDS=
# Optional: Telegram 2-step verification (cloud) password. Leave empty to type it in the terminal.
# TELETHON_PASSWORD=
# Session under data/ (gitignored). First run: phone + login code in the terminal.
# TELETHON_SESSION=data/telethon.session
