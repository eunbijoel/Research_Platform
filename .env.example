# Streamlit web app password (first-screen gate). Required to open the UI.
RM_APP_PASSWORD=

# Telegram user-admin page only (not the normal web login password).
# Required to add/remove Telegram user IDs that may DM the Research Bot.
RM_TELEGRAM_ADMIN_PASSWORD=

# Optional. Same DB the bot uses for chat log + allowed Telegram users.
# TELEGRAM_CHAT_DB=telegram_memory/data/chat.sqlite3
